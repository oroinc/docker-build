# DSN over TLS for ORO_SERVICES_TLS=tls (EE). Loaded after .env-ce-no and overrides only these variables.
# The CA is mounted by compose-tls.yaml, the certificate of the services is issued by pki-init.
# Redis requires a password with TLS: Dragonfly does not start with TLS and without authentication.
# The DSN use ORO_REDIS_TLS_URL, not ORO_REDIS_URL: CI puts ORO_REDIS_URL of .env-ce-* (plain) in the shell, and
# compose takes a variable of the shell instead of the value from this file. No quotes: Jenkins reads this file with
# readProperties, which keeps them in the value.
ORO_REDIS_PASSWORD=oro_redis_pass
ORO_REDIS_TLS_URL=rediss://:${ORO_REDIS_PASSWORD}@session-storage:6379
ORO_REDIS_URL=${ORO_REDIS_TLS_URL}
ORO_SESSION_DSN=${ORO_REDIS_TLS_URL}/0?ssl[cafile]=/etc/oro-services-tls/ca.pem
ORO_REDIS_CACHE_DSN=${ORO_REDIS_TLS_URL}/1?ssl[cafile]=/etc/oro-services-tls/ca.pem
ORO_REDIS_DOCTRINE_DSN=${ORO_REDIS_TLS_URL}/2?ssl[cafile]=/etc/oro-services-tls/ca.pem
ORO_REDIS_LAYOUT_DSN=${ORO_REDIS_TLS_URL}/3?ssl[cafile]=/etc/oro-services-tls/ca.pem
ORO_SEARCH_ENGINE_DSN=https://search-engine:9200?prefix=oro_search&ssl[cafile]=/etc/oro-services-tls/ca.pem
ORO_WEBSITE_SEARCH_ENGINE_DSN=https://search-engine:9200?prefix=oro_website_search&ssl[cafile]=/etc/oro-services-tls/ca.pem
ORO_MQ_DSN=amqps://oro_mq_user:oro_mq_pass@mq:5671/?ssl[cafile]=/etc/oro-services-tls/ca.pem
